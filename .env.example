NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Zonapagos (pasarela de pagos) — usadas por las Supabase Edge Functions
# zonapagos-inicio/zonapagos-sonda/zonapagos-sync, y por app/api/zonapagos-token-notify
# para validar el webhook de tokenización.
ZONAPAGOS_ID_COMERCIO=
ZONAPAGOS_USUARIO=
ZONAPAGOS_CLAVE=
ZONAPAGOS_CODIGO_SERVICIO=
ZONAPAGOS_APP_URL=
# Secreto compartido para proteger el cron que invoca zonapagos-sonda
# y el cron de reconciliación app/api/pibox/sync
CRON_SECRET=

# Pibox / Picap (logística de domicilios) — usadas por lib/pibox/* y app/api/pibox/*
# Kill-switch: con PIBOX_ENABLED=false la integración queda inerte (no se crean
# bookings) y el envío sigue usando la tarifa fija.
PIBOX_ENABLED=false
PIBOX_API_URL=https://turing.thetrancon.com/api/third
# La API de Pibox NO usa header Authorization: el token viaja como query param ?t=
PIBOX_API_TOKEN=
# Mensajería en moto. Para vehículos de carga ver "Servicios de carga" en docs/picap.MD
PIBOX_SERVICE_TYPE_ID=5c71b03a58b9ba10fa6393cf
# Secreto propio que se registra como header al crear el webhook en Pibox
# y que valida app/api/pibox/webhook. Pendiente de definir.
PIBOX_WEBHOOK_SECRET=
# Tamaño de paquete por defecto (0 muy pequeño, 1 pequeño, 2 mediano, 3 grande)
PIBOX_DEFAULT_PACKAGE_SIZE_CD=2

# Siigo (contabilidad y facturación electrónica) — usadas por lib/siigo/*
SIIGO_USERNAME=
SIIGO_ACCESS_KEY=
# Obligatorio según la documentación de Siigo (3-100 alfanuméricos)
SIIGO_PARTNER_ID=
SIIGO_API_URL=https://api.siigo.com

# Ids de la cuenta de Siigo. Los valores por defecto del código son los de la
# cuenta de producción; acá se dejan vacíos para que cada entorno ponga los suyos.
# Se consultan con: GET /v1/document-types?type=FV, /v1/users, /v1/payment-types,
# /v1/account-groups
SIIGO_FV_DOCUMENT_ID=
SIIGO_SELLER_ID=
SIIGO_ACCOUNT_GROUP_ID=
SIIGO_PAYMENT_TYPE_CASH=
SIIGO_PAYMENT_TYPE_CARD=
# La cuenta NO tiene un tipo de pago para PSE: cae en este genérico hasta que el
# contador del cliente indique cuál corresponde.
SIIGO_PAYMENT_TYPE_DEFAULT=

# ATENCIÓN: en true cada factura se transmite a la DIAN y queda emitida de
# verdad; corregir un error obliga a emitir nota crédito. Se deja apagado hasta
# validar el flujo completo.
SIIGO_STAMP_SEND=false
SIIGO_MAIL_SEND=false

# Código del producto de Siigo con el que se factura el domicilio. Sin él, un
# pedido con domicilio no se puede facturar (el total no cuadraría con el pago).
SIIGO_DELIVERY_PRODUCT_CODE=

# Ciudad por defecto del tercero (códigos DANE que exige POST /v1/customers).
# delivery_addresses solo guarda texto libre, así que no se pueden derivar.
SIIGO_DEFAULT_COUNTRY_CODE=CO
SIIGO_DEFAULT_STATE_CODE=05
SIIGO_DEFAULT_CITY_CODE=05001
SIIGO_DEFAULT_ID_TYPE=13
SIIGO_MAX_INVOICE_ATTEMPTS=5
