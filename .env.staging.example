# Copia este archivo como `.env.staging` (no va a git) y llénalo con los datos del
# proyecto de STAGING en Supabase (pzvtrduhbcqcnnpdkcct). Nunca los de producción:
# los scripts se niegan a correr si alguna URL apunta a producción.
#
# Lo usan `pnpm staging:refresh` y `pnpm staging:sync-storage`. El despliegue de
# staging en Vercel lleva estas mismas variables (más las de .env.example), y el
# despliegue automático de GitHub las toma de los secretos del entorno `staging`.

# Panel de Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://pzvtrduhbcqcnnpdkcct.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Panel de Supabase → botón «Connect» → «Session pooler» (puerto 5432), con la
# contraseña de la base. No la conexión directa: es solo IPv6 y desde muchas redes
# (y desde GitHub Actions) no conecta. Si la contraseña tiene caracteres como
# @ # / ? %, van codificados (%40, %23, ...).
STAGING_DB_URL=

# La URL pública del despliegue de staging en Vercel. Las tareas programadas la
# usan para llamar a la aplicación. Mientras no exista, cualquier URL sirve.
STAGING_APP_URL=

# Inventa uno largo y aleatorio. Es el mismo valor que lleva CRON_SECRET en las
# variables de staging de Vercel; queda en el Vault de staging como app_cron_secret.
CRON_SECRET=
