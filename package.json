{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "next dev -p 4005",
    "build": "next build",
    "start": "next start -p 4005",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:pull-data": "supabase db dump --linked --data-only --schema public,auth -x public.actions,public.roles,public.modules,public.role_permissions,auth.sessions,auth.refresh_tokens,auth.audit_log_entries,auth.flow_state,auth.one_time_tokens,auth.mfa_factors,auth.mfa_challenges,auth.mfa_amr_claims,auth.mfa_recovery_code_sets,auth.mfa_recovery_codes,auth.schema_migrations,auth.instances,auth.saml_providers,auth.saml_relay_states,auth.sso_providers,auth.sso_domains,auth.oauth_clients,auth.oauth_authorizations,auth.oauth_client_states,auth.oauth_consents,auth.custom_oauth_providers,auth.scim_tokens,auth.scim_users,auth.webauthn_challenges,auth.webauthn_credentials -f supabase/seed/prod_data.sql",
    "gen:types": "pnpm dlx supabase gen types typescript --project-id zaqvcpehhmkiyjdbcufj > types/database_generated.ts",
    "gen:types:local": "supabase gen types typescript --local --schema public > types/database_generated.ts",
    "db:sync-storage": "tsx scripts/sync-storage-local.ts",
    "local:pay": "tsx scripts/local-pay.ts",
    "backfill:images": "tsx scripts/backfill-image-variants.ts",
    "pibox:hooks": "tsx scripts/pibox-webhooks.ts",
    "lint": "next lint",
    "siigo": "tsx scripts/siigo.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
