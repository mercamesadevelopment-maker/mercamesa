    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "libphonenumber-js": "^1.13.13",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^16.3.7",
    "papaparse": "^5.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-international-phone": "^4.8.0",
    "recharts": "^3.8.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.5.0"
  },
